{
  "name": "@map/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'src/faults/**'",
    "test:integration": "vitest run --config vitest.faults.config.ts",
    "test:faults": "vitest run --config vitest.faults.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@map/shared": "workspace:*",
    "bullmq": "^5.58.5",
    "dotenv": "^17.2.2",
    "ioredis": "^5.7.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "sharp": "^0.34.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
